id: hidemyemulator-premium
target: net.wowsoftware.hidemyemulator
name: HideMyEmulator Premium Unlock
author: reverser.id
tags: premium, license, unlock, xposed
versions: 1.3 · 1.4 · 1.5
source: https://play.google.com/store/apps/details?id=net.wowsoftware.hidemyemulator
desc: Forces lifetime-premium license state for net.wowsoftware.hidemyemulator (1.3, 1.4, 1.5). Unlocks all protection toggles + Apply, removes the paywall, adds patched-by credit + styled launch toast.

variant ^1\.4

rule d9/b mapper -> premium
file: smali/d9/b.smali
count: 1
find <<<
\.method public static r\(Ljava/lang/String;Ljava/lang/String;Ljava/time/ZoneId;\)Lnb/s;.*?\.end method
<<<
replace <<<
.method public static r(Ljava/lang/String;Ljava/lang/String;Ljava/time/ZoneId;)Lnb/s;
    .locals 1
    new-instance p0, Lnb/p;
    const/4 v0, 0x0
    invoke-direct {p0, v0, v0}, Lnb/p;-><init>(Ljava/lang/Long;Ljava/lang/String;)V
    return-object p0
.end method
<<<

rule ec/q flow -> premium
file: smali/ec/q.smali
count: 1
find <<<
(:cond_0\n)    sget-object p1, Lnb/r;->a:Lnb/r;
<<<
replace <<<
$1    new-instance p1, Lnb/p;
    const/4 v1, 0x0
    invoke-direct {p1, v1, v0}, Lnb/p;-><init>(Ljava/lang/Long;Ljava/lang/String;)V
<<<

