id: hidemyemulator-premium
target: net.wowsoftware.hidemyemulator
name: HideMyEmulator Premium Unlock
author: reverser.id
tags: premium, license, unlock, xposed
versions: 1.3 · 1.4
source: https://play.google.com/store/apps/details?id=net.wowsoftware.hidemyemulator
desc: Forces lifetime-premium license state for net.wowsoftware.hidemyemulator (1.3 and 1.4). Unlocks all protection toggles + Apply, removes the paywall, adds patched-by credit + launch toast.

variant ^1\.4

rule d9/b mapper -> premium
file: smali/d9/b.smali
count: 1
find <<<
\.method public static r\(Ljava/lang/String;Ljava/lang/String;Ljava/time/ZoneId;\)Lnb/s;.*?\.end method
<<<
replace <<<
.method public static r(Ljava/lang/String;Ljava/lang/String;Ljava/time/ZoneId;)Lnb/s;
    .locals 1
    new-instance p0, Lnb/p;
    const/4 v0, 0x0
    invoke-direct {p0, v0, v0}, Lnb/p;-><init>(Ljava/lang/Long;Ljava/lang/String;)V
    return-object p0
.end method
<<<

rule ec/q flow -> premium
file: smali/ec/q.smali
count: 1
find <<<
(:cond_0\n)    sget-object p1, Lnb/r;->a:Lnb/r;
<<<
replace <<<
$1    new-instance p1, Lnb/p;
    const/4 v1, 0x0
    invoke-direct {p1, v1, v0}, Lnb/p;-><init>(Ljava/lang/Long;Ljava/lang/String;)V
<<<

rule ModuleStatus -> active
file: smali/net/wowsoftware/hidemyemulator/core/ModuleStatus.smali
count: 1
find <<<
(\.method public final isModuleActive\(\)Z\n    \.locals 1\n\n    \.line 1\n)    const/4 v0, 0x0
<<<
replace <<<
$1    const/4 v0, 0x1
<<<

rule hc/r unlock -> true
file: smali/hc/r.smali
count: 1
find <<<
    if-ne p1, v0, :cond_4
<<<
replace <<<
    const/4 p1, 0x1

<<<

rule hc/s a-flag -> true
file: smali/hc/s.smali
count: 1
find <<<
    iget-boolean v2, v0, Lhc/s;->i:Z
<<<
replace <<<
    const/4 v2, 0x1
<<<

rule hc/s i-flag -> true
file: smali/hc/s.smali
count: 1
find <<<
    iget-boolean v10, v0, Lhc/s;->m:Z
<<<
replace <<<
    const/4 v10, 0x1
<<<

rule hc/s license -> premium
file: smali/hc/s.smali
count: 1
find <<<
(:cond_0\n)    const-wide v11, -0x14040da4ffffffd6L
<<<
replace <<<
$1    new-instance v1, Lnb/p;
    const/4 v7, 0x0
    invoke-direct {v1, v7, v7}, Lnb/p;-><init>(Ljava/lang/Long;Ljava/lang/String;)V
    const-wide v11, -0x14040da4ffffffd6L
<<<

rule hc/t i-flag -> true
file: smali/hc/t.smali
count: 1
find <<<
    const/4 v15, 0x0
<<<
replace <<<
    const/4 v15, 0x1
<<<

rule hc/t a-flag -> true
file: smali/hc/t.smali
count: 1
find <<<
    move v7, v3
<<<
replace <<<
    const/4 v7, 0x1
<<<

rule hc/t license -> premium
file: smali/hc/t.smali
count: 1
find <<<
    sget-object v8, Lnb/q;->a:Lnb/q;
<<<
replace <<<
    new-instance v8, Lnb/p;
    const/4 v9, 0x0
    invoke-direct {v8, v9, v9}, Lnb/p;-><init>(Ljava/lang/Long;Ljava/lang/String;)V
<<<

rule values status -> Premium
file: res/values/strings.xml
count: 1
find <<<
<string name=\"app_info_not_activated\">.*?</string>
<<<
replace <<<
<string name="app_info_not_activated">Premium</string>
<<<

