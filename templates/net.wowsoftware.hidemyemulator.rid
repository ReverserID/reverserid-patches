rule launch toast
file: smali/net/wowsoftware/hidemyemulator/MainActivity.smali
count: 1
must: reverser.id
find <<<
(\.method public final onCreate\(Landroid/os/Bundle;\)V\n    \.locals 9\n\n    \.line 1\n)
<<<
replace <<<
$1    const-string v9, "Patched by reverser.id | https://reverser.id"
    const/4 v10, 0x1
    invoke-static {p0, v9, v10}, Landroid/widget/Toast;->makeText(Landroid/content/Context;Ljava/lang/CharSequence;I)Landroid/widget/Toast;
    move-result-object v9
    invoke-virtual {v9}, Landroid/widget/Toast;->show()V

<<<

rule toast registers
file: smali/net/wowsoftware/hidemyemulator/MainActivity.smali
count: 1
find <<<
(\.method public final onCreate\(Landroid/os/Bundle;\)V\n)    \.locals 9
<<<
replace <<<
$1    .locals 11
<<<

