{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "reverser.id patch template",
  "type": "object",
  "required": ["id", "info", "target", "variants"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "info": {
      "type": "object",
      "required": ["name", "author"],
      "properties": {
        "name": { "type": "string" },
        "author": { "type": "string" },
        "severity": { "type": "string", "enum": ["info", "low", "medium", "high"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "versions": { "type": "string", "description": "display string for supported versions, e.g. '1.3 · 1.4'" },
        "source": { "type": "string", "description": "URL to obtain the original/unpatched APK" },
        "reference": { "type": "array", "items": { "type": "string" } }
      }
    },
    "target": {
      "type": "object",
      "required": ["package"],
      "properties": { "package": { "type": "string" } }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["match", "patches"],
        "properties": {
          "match": {
            "type": "object",
            "properties": { "version_name": { "type": "string", "description": "regex matched against versionName" } }
          },
          "patches": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name", "file", "find", "replace"],
              "properties": {
                "name": { "type": "string" },
                "file": { "type": "string", "description": "path inside the apktool-decoded tree" },
                "find": { "type": "string", "description": "regex (always DOTALL)" },
                "replace": { "type": "string", "description": "$N / ${N} backrefs, $$ = literal $" },
                "count": { "type": "integer", "default": 1, "description": "required match count; run aborts on mismatch" },
                "must_contain": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "properties": {
        "tool": { "type": "string", "enum": ["apktool"] },
        "sign": { "type": "string", "enum": ["ephemeral", "none"] }
      }
    }
  }
}
